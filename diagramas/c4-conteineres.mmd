C4Container
    title C4 Nível 2 (Contêineres) - Sistema de Orquestração de Entregas Autônomas (AGVs)

    Person(supervisor, "Supervisor de Operações", "Define políticas de negócio, prioriza solicitações e acompanha indicadores de desempenho")
    Person(operador, "Operador Logístico", "Registra e cancela solicitações, monitora missões e AGVs, gerencia a frota e consulta o histórico")

    System_Ext(corporativo, "Sistema Corporativo (ERP/WMS)", "Origina solicitações de transporte e recebe a notificação de conclusão")
    System_Ext(frota, "Frota AGV", "Veículos autônomos que executam as missões e solicitam recarga")
    System_Ext(rtls, "Infraestrutura de Localização (RTLS)", "Fornece posição em tempo real e dados de tráfego do parque industrial")

    System_Boundary(orq, "Sistema de Orquestração de Entregas Autônomas") {
        Container(web, "Portal de Operações", "SPA - React/TypeScript", "Painel de monitoramento, solicitações, gestão de frota, alertas e indicadores")
        Container(api, "API Gateway / BFF", "REST + WebSocket", "Ponto único de entrada: autenticação, autorização por perfil e push de atualizações em tempo real")
        Container(integracao, "Serviço de Integração Corporativa", "Adapter REST / Webhooks", "Recebe solicitações do Sistema Corporativo e notifica a origem na conclusão")

        Container(missoes, "Serviço de Missões", "Java / Spring Boot", "Registrar, planejar, cancelar, interromper e concluir missões. Aplica políticas e prioridades")
        Container(despacho, "Serviço de Despacho e Alocação", "Java / Spring Boot", "Aloca o AGV à missão considerando disponibilidade, distância e nível de bateria. Gerencia recarga")
        Container(roteamento, "Serviço de Roteamento", "Python", "Roteia a missão, reserva trechos de rota e recalcula a rota conforme o tráfego")
        Container(telemetria, "Serviço de Rastreamento e Telemetria", "Go", "Consome posições do RTLS e da frota, acompanha posição em tempo real e redistribui missões")
        Container(alertas, "Serviço de Alertas e Notificações", "Node.js", "Emite alertas operacionais (bateria baixa, falha, atraso, bloqueio de rota)")
        Container(gatewayFrota, "Gateway da Frota AGV", "MQTT / VDA 5050", "Traduz comandos de missão para o protocolo dos AGVs e recebe status e eventos")

        ContainerQueue(broker, "Barramento de Eventos", "Apache Kafka", "Eventos de domínio: MissaoCriada, AgvAlocado, RotaReservada, PosicaoAtualizada, MissaoConcluida")
        ContainerDb(dbOper, "Banco Operacional", "PostgreSQL", "Missões, solicitações, frota, políticas, rotas reservadas")
        ContainerDb(dbHist, "Banco de Rastreabilidade", "TimescaleDB", "Histórico de posições, eventos e indicadores de desempenho")
        ContainerDb(cache, "Estado em Tempo Real", "Redis", "Posição atual e estado/bateria de cada AGV, reservas de trechos ativos")
    }

    Rel(supervisor, web, "Define políticas, prioriza e consulta indicadores", "HTTPS")
    Rel(operador, web, "Registra, cancela e monitora missões e frota", "HTTPS")
    Rel(web, api, "Chamadas de API e atualizações em tempo real", "HTTPS / WebSocket")

    Rel(corporativo, integracao, "Envia solicitação de transporte", "REST/JSON")
    Rel(integracao, corporativo, "Notifica conclusão da missão", "Webhook")
    Rel(integracao, missoes, "Registra solicitação", "REST")

    Rel(api, missoes, "Comandos de missão", "REST")
    Rel(api, despacho, "Gestão de frota e recarga", "REST")
    Rel(api, telemetria, "Consulta posição e histórico", "REST")

    Rel(missoes, despacho, "Solicita alocação de AGV", "REST")
    Rel(missoes, roteamento, "Solicita rota da missão", "REST")
    Rel(missoes, dbOper, "Lê e grava missões", "JDBC")
    Rel(despacho, dbOper, "Lê e grava frota e alocações", "JDBC")
    Rel(despacho, cache, "Consulta estado e bateria dos AGVs", "RESP")
    Rel(roteamento, rtls, "Consulta tráfego", "API RTLS")
    Rel(roteamento, cache, "Reserva trechos de rota", "RESP")

    Rel(despacho, gatewayFrota, "Comanda missão / envia para recarga", "gRPC")
    Rel(gatewayFrota, frota, "Comandos de missão", "MQTT (VDA 5050)")
    Rel(frota, gatewayFrota, "Status, bateria e solicitação de recarga", "MQTT (VDA 5050)")

    Rel(rtls, telemetria, "Publica posições", "MQTT / stream")
    Rel(telemetria, cache, "Atualiza posição atual", "RESP")
    Rel(telemetria, dbHist, "Grava histórico de posições", "SQL")

    Rel(gatewayFrota, broker, "Publica eventos da frota", "Kafka")
    Rel(telemetria, broker, "Publica PosicaoAtualizada", "Kafka")
    Rel(missoes, broker, "Publica eventos de missão", "Kafka")
    Rel(broker, alertas, "Consome eventos críticos", "Kafka")
    Rel(broker, integracao, "Consome MissaoConcluida", "Kafka")
    Rel(alertas, api, "Envia alertas ao portal", "WebSocket")

    UpdateLayoutConfig($c4ShapeInRow="4", $c4BoundaryInRow="1")
