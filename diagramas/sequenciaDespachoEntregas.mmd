sequenceDiagram
    title Diagrama de Sequência - Despacho de Entregas (AGVs)
    autonumber

    actor OP as Operador Logístico
    participant SC as Sistema Corporativo
    participant INT as Serviço de Integração
    participant API as API Gateway
    participant MIS as Serviço de Missões
    participant DES as Serviço de Despacho e Alocação
    participant ROT as Serviço de Roteamento
    participant RTLS as Infraestrutura RTLS
    participant GW as Gateway da Frota
    participant AGV as Frota AGV
    participant TEL as Serviço de Telemetria
    participant ALE as Serviço de Alertas

    %% Registro da solicitação (pelo operador ou pelo sistema corporativo)
    alt Solicitação manual
        OP->>API: Registrar solicitação de transporte (origem, destino, carga, prioridade)
        API->>MIS: POST /missoes
    else Solicitação automática
        SC->>INT: Enviar solicitação de transporte
        INT->>MIS: POST /missoes
    end

    activate MIS
    MIS->>MIS: Validar dados e aplicar políticas de prioridade
    MIS->>MIS: Planejar missão de transporte (include)

    %% Alocação do AGV
    MIS->>DES: Alocar AGV à missão
    DES->>DES: Buscar AGVs livres mais próximos da origem
    DES->>GW: Consultar estado e nível de bateria do AGV candidato
    GW->>AGV: Solicitar status
    AGV-->>GW: Status + nível de bateria
    GW-->>DES: Estado do AGV

    alt Bateria suficiente para a rota (acima do limite mínimo)
        DES-->>MIS: AGV alocado

        %% Roteamento
        MIS->>ROT: Rotear missão (origem, destino, AGV)
        activate ROT
        ROT->>RTLS: Consultar tráfego
        RTLS-->>ROT: Ocupação dos corredores
        ROT->>ROT: Calcular melhor rota
        ROT->>ROT: Reservar trechos da rota (include)
        ROT-->>MIS: Rota reservada
        deactivate ROT

        %% Execução
        MIS->>GW: Comandar execução da missão (rota)
        GW->>AGV: Enviar ordem de missão
        AGV-->>GW: Ordem aceita
        GW-->>MIS: Missão em execução
        MIS-->>API: Status: EM_EXECUCAO
        API-->>OP: Atualizar painel de monitoramento

        loop Durante o trajeto
            RTLS->>TEL: Posição atualizada do AGV
            TEL-->>API: Posição em tempo real
            opt Obstáculo ou tráfego na rota
                TEL->>ROT: Recalcular rota (extend)
                ROT->>GW: Nova rota
                GW->>AGV: Atualizar rota
            end
        end

        %% Conclusão
        AGV->>GW: Entrega realizada no destino
        GW->>MIS: Evento missão concluída
        MIS->>ROT: Liberar trechos reservados
        MIS->>INT: Concluir missão e notificar origem
        INT->>SC: Notificar conclusão da entrega
        MIS-->>API: Status: CONCLUIDA
        API-->>OP: Missão concluída
    else Bateria insuficiente
        DES->>GW: Enviar AGV para estação de recarga
        GW->>AGV: Comando de recarga
        DES->>ALE: Emitir alerta de bateria baixa
        ALE-->>API: Alerta operacional
        API-->>OP: Notificar alerta

        alt Outro AGV disponível com bateria suficiente
            DES->>DES: Selecionar próximo AGV candidato
            DES-->>MIS: AGV alternativo alocado (segue fluxo de roteamento)
        else Nenhum AGV disponível
            DES-->>MIS: Sem AGV disponível
            MIS->>MIS: Manter missão na fila (status AGUARDANDO_AGV)
            MIS-->>API: Status: AGUARDANDO_AGV
            API-->>OP: Missão em espera
        end
    end
    deactivate MIS
